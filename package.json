{
  "name": "@tracebackai/cli",
  "version": "1.0.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Run and watch Traceback AI browser/mobile tests from your terminal",
  "keywords": [
    "traceback",
    "qa",
    "testing",
    "e2e",
    "browser-testing",
    "mobile-testing",
    "ai-agent",
    "cli",
    "mcp"
  ],
  "homepage": "https://docs.traceback.dev",
  "bugs": "https://github.com/TracebackAI/cli/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TracebackAI/cli.git"
  },
  "license": "MIT",
  "author": "Traceback Team",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "traceback": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@9.14.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack:check": "pnpm build && npm pack --dry-run",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.2",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "env-paths": "^3.0.0",
    "ora": "^8.0.1",
    "pino": "^9.1.0",
    "pino-pretty": "^11.1.0",
    "socket.io-client": "^4.8.3",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.4.0",
    "eslint-config-prettier": "^9.1.0",
    "execa": "^9.2.0",
    "husky": "^9.0.11",
    "nock": "^13.5.4",
    "prettier": "^3.3.1",
    "strip-ansi": "^7.1.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
