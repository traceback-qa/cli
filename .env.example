# ──────────────────────────────────────────────
# Traceback CLI — Environment Variables
# Copy to .env and fill in values as needed.
# Never commit .env to version control.
# ──────────────────────────────────────────────

# --- API Connection ---
# Override the Traceback API base URL.
# Default: http://localhost:8000
TRACEBACK_API_URL=http://localhost:8000

# --- Environment ---
# Default execution environment for test runs.
# Default: production
# TRACEBACK_ENVIRONMENT=production

# --- Telemetry ---
# Disable anonymized usage telemetry.
# Set to true, 1, yes, or on to opt out.
# TRACEBACK_TELEMETRY_OFF=false

# --- Paths ---
# Override the global config directory.
# Default (macOS):  ~/Library/Application Support/traceback
# Default (Linux):   ~/.config/traceback
# Default (Windows): %APPDATA%/traceback
# TRACEBACK_CONFIG_DIR=

# Override the logs directory.
# Default (macOS):  ~/Library/Application Support/traceback/logs
# Default (Linux):   ~/.local/share/traceback/logs
# Default (Windows): %LOCALAPPDATA%/traceback/logs
# TRACEBACK_LOG_DIR=

# --- CI / Automation ---
# Force non-interactive CI mode (no spinners or prompts).
# Automatically set when CI=true is present in the environment.
# TRACEBACK_CI=true

# --- Version ---
# CLI version embedded in the User-Agent header sent to the API.
# Typically set at build time — not needed for local development.
# TRACEBACK_VERSION=0.1.0
