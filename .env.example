# Traceback CLI — Environment Variables
# Copy to .env and fill in values for local development
# Never commit .env to version control

# API
TRACEBACK_API_URL=https://api.traceback.dev

# Debug & Output
# TRACEBACK_DEBUG=1
# TRACEBACK_JSON=1
# TRACEBACK_SILENT=1
# TRACEBACK_NO_COLOR=1
# TRACEBACK_CI=1

# Auth (for CI/CD testing — not recommended for local use)
# TRACEBACK_TOKEN=<your-token>

# Paths (override defaults)
# TRACEBACK_CONFIG_DIR=/custom/path
# TRACEBACK_LOG_DIR=/custom/path
